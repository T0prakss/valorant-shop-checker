# Fernet encryption key for session data at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Comma-separated list of allowed CORS origins (include http://localhost for the OAuth redirect page)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Environment: development | production
ENVIRONMENT=development

# Backend API URL (used by the OAuth redirect page to call back to the API)
API_URL=http://localhost:8000
